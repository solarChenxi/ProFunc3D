@@ -28,6 +28,71 @@ from datasets.scannet200.scannet200_constants import (
 logger = logging.getLogger(__name__)
 
 
+def curriculum_mask_radius(
+    epoch: int, r0: float = 0.1, decay: float = 0.5, alpha: int = 200
+) -> float:
+    """Mask3D-F appendix: r(e) = r0 * decay^(floor(e/alpha))."""
+    if epoch < 0:
+        return 0.0
+    return float(r0 * (decay ** (epoch // alpha)))
+
+
+def expand_instance_masks_ball(
+    coordinates: np.ndarray,
+    labels: np.ndarray,
+    radius: float,
+    ignore_label: int = 255,
+    max_points: int = 600000,
+) -> np.ndarray:
+    """Dilate GT instance masks in xyz; only fill ignore/unlabeled points.
+
+    Optimized for SceneFun3D laser scans: query only unlabeled points, and
+    skip expansion on oversized clouds (crop fallback) to avoid DDP stalls.
+    """
+    if radius <= 0 or labels.shape[0] == 0:
+        return labels
+    if coordinates.shape[0] > max_points:
+        # Prefer keeping training alive over perfect curriculum on huge clouds.
+        return labels
+    labels = labels.copy()
+    sem = labels[:, 0]
+    inst = labels[:, 1]
+    positive = inst > 0
+    if not np.any(positive):
+        return labels
+    unlabeled = (sem == ignore_label) | (inst <= 0)
+    if not np.any(unlabeled):
+        return labels
+    unlabeled_idx = np.flatnonzero(unlabeled)
+    unlabeled_coords = coordinates[unlabeled_idx]
+    for iid in np.unique(inst[positive]):
+        seed_mask = inst == iid
+        seed_coords = coordinates[seed_mask]
+        if seed_coords.shape[0] == 0:
+            continue
+        sem_val = int(sem[seed_mask][0])
+        tree = scipy.spatial.cKDTree(seed_coords)
+        dists, _ = tree.query(
+            unlabeled_coords, k=1, distance_upper_bound=radius, workers=-1
+        )
+        near_local = np.isfinite(dists)
+        if not np.any(near_local):
+            continue
+        assign_idx = unlabeled_idx[near_local]
+        # Do not overwrite other instances (unlabeled_idx already excludes them).
+        sem[assign_idx] = sem_val
+        inst[assign_idx] = iid
+        # Refresh unlabeled set cheaply for subsequent instances.
+        still = (sem[unlabeled_idx] == ignore_label) | (inst[unlabeled_idx] <= 0)
+        unlabeled_idx = unlabeled_idx[still]
+        unlabeled_coords = coordinates[unlabeled_idx]
+        if unlabeled_idx.size == 0:
+            break
+    labels[:, 0] = sem
+    labels[:, 1] = inst
+    return labels
+
+
