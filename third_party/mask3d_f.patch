+    def _mask_iou_indices(a: np.ndarray, b: np.ndarray) -> float:
+        """IoU of two sorted unique index arrays (avoids full-scene bool AND)."""
+        if a.size == 0 or b.size == 0:
+            return 0.0
+        inter = np.intersect1d(a, b, assume_unique=True).size
