+        scores,
+        classes,
+        n_full: int,
+        iou_thr: float = 0.3,
+        max_keep: int = 100,
+    ):
+        """Class-wise greedy NMS on sparse index masks → dense (N,K) bool."""
+        keep_idx, keep_s, keep_c = [], [], []
+        by_c = defaultdict(list)
+        for i, c in enumerate(classes):
