+            for i in order:
+                if i in suppressed:
+                    continue
+                keep_idx.append(index_masks[i])
+                keep_s.append(scores[i])
+                keep_c.append(c)
+                kept_c += 1
+                if kept_c >= max_keep:
+                    break
+                ai = index_masks[i]
+                for j in order:
+                    if j == i or j in suppressed:
