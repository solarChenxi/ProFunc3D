diff --git a/conf/data/datasets/scenefun3d.yaml b/conf/data/datasets/scenefun3d.yaml
new file mode 100644
index 0000000..557585a
--- /dev/null
+++ b/conf/data/datasets/scenefun3d.yaml
@@ -0,0 +1,102 @@
+# @package data
+# Drop-in dataset yaml for third_party/Mask3D (copy to conf/data/datasets/).
+# Paths are relative to third_party/Mask3D. The ProFunc3D exporter overrides
+# all three paths explicitly when a different --processed directory is used.
+#
+# Class layout (label_database.yaml):
+#   0 empty (not validation), 1..9 affordance, ignore_label=255
+# Remap: with num_labels=9 → validation-only labels remapped 0..8.
+# IMPORTANT: after remap, targets are already 0..8. Use label_offset=0 and
+# filter_out_classes=[] (NOT ScanNet/STPLS style offset=1 / filter [0], which
+# drops rotate and shifts every class id → AP≈0 at eval).
+
+train_dataset:
+  _target_: datasets.semseg.SemanticSegmentationDataset
+  dataset_name: "scenefun3d"
+  data_dir: ../../outputs/val/mask3d_processed
+  image_augmentations_path: conf/augmentation/albumentations_aug.yaml
+  volume_augmentations_path: conf/augmentation/volumentations_aug.yaml
+  label_db_filepath: ../../outputs/val/mask3d_processed/label_database.yaml
+  color_mean_std: ../../outputs/val/mask3d_processed/color_mean_std.yaml
+  data_percent: 1.0
+  mode: ${data.train_mode}
+  ignore_label: ${data.ignore_label}
+  num_labels: ${data.num_labels}
+  add_raw_coordinates: ${data.add_raw_coordinates}
+  add_colors: ${data.add_colors}
+  add_normals: ${data.add_normals}
+  add_instance: ${data.add_instance}
+  instance_oversampling: 0.0
+  place_around_existing: false
+  point_per_cut: 0
+  max_cut_region: 0
+  flip_in_center: false
+  noise_rate: 0
+  resample_points: 0
+  add_unlabeled_pc: false
+  cropping: ${data.cropping}
+  cropping_args: ${data.cropping_args}
+  is_tta: false
+  crop_min_size: ${data.crop_min_size}
+  crop_length: ${data.crop_length}
+  filter_out_classes: []
+  label_offset: 0
+  database_basename: null
+  curriculum_mask_expand: true
+  curriculum_r0: 0.1
+  curriculum_decay: 0.5
+  curriculum_alpha: 200
+  # Fraction of train crops centered on a GT instance (rest = random cuboid).
+  instance_crop_prob: 0.5
+
+validation_dataset:
+  _target_: datasets.semseg.SemanticSegmentationDataset
+  dataset_name: "scenefun3d"
+  data_dir: ../../outputs/val/mask3d_processed
+  image_augmentations_path: null
+  volume_augmentations_path: null
+  label_db_filepath: ../../outputs/val/mask3d_processed/label_database.yaml
+  color_mean_std: ../../outputs/val/mask3d_processed/color_mean_std.yaml
+  data_percent: 1.0
+  mode: ${data.validation_mode}
+  ignore_label: ${data.ignore_label}
+  num_labels: ${data.num_labels}
+  add_raw_coordinates: ${data.add_raw_coordinates}
+  add_colors: ${data.add_colors}
+  add_normals: ${data.add_normals}
+  add_instance: ${data.add_instance}
+  cropping: false
+  is_tta: false
+  crop_min_size: ${data.crop_min_size}
+  crop_length: ${data.crop_length}
+  # When true, val uses precomputed 4m sliding crops (build_sliding_val_crops.py)
+  # so eval matches train crop scale (closes full-scene blob domain gap).
+  sliding_window: false
+  crop_stride: 2.0
+  filter_out_classes: []
+  label_offset: 0
+
+test_dataset:
+  _target_: datasets.semseg.SemanticSegmentationDataset
+  dataset_name: "scenefun3d"
+  data_dir: ../../outputs/val/mask3d_processed
+  image_augmentations_path: null
+  volume_augmentations_path: null
+  label_db_filepath: ../../outputs/val/mask3d_processed/label_database.yaml
+  color_mean_std: ../../outputs/val/mask3d_processed/color_mean_std.yaml
+  data_percent: 1.0
+  mode: ${data.test_mode}
+  ignore_label: ${data.ignore_label}
+  num_labels: ${data.num_labels}
+  add_raw_coordinates: ${data.add_raw_coordinates}
+  add_colors: ${data.add_colors}
+  add_normals: ${data.add_normals}
+  add_instance: ${data.add_instance}
+  cropping: false
+  is_tta: false
+  crop_min_size: ${data.crop_min_size}
+  crop_length: ${data.crop_length}
+  sliding_window: false
+  crop_stride: 2.0
+  filter_out_classes: []
+  label_offset: 0

diff --git a/conf/data/indoor_scenefun3d.yaml b/conf/data/indoor_scenefun3d.yaml
new file mode 100644
index 0000000..36e6094
--- /dev/null
+++ b/conf/data/indoor_scenefun3d.yaml
@@ -0,0 +1,38 @@
+# @package _group_
+# Override for SceneFun3D Task-1 (9 affordance classes).
+# Use with: data=indoor_scenefun3d  data/datasets=scenefun3d
+# Copy into third_party/Mask3D/conf/data/
+
+train_mode: train
+validation_mode: validation
+test_mode: validation
+
+ignore_label: 255
+add_raw_coordinates: true
+add_colors: true
+add_normals: false
+in_channels: 3
+num_labels: 9
+add_instance: ${general.add_instance}
+task: ${general.task}
+
+pin_memory: false
+num_workers: 4
+batch_size: 2
+test_batch_size: 1
+cache_data: false
+
+voxel_size: 0.02
+
+reps_per_epoch: ${general.reps_per_epoch}
+
+cropping: false
+cropping_args:
+  min_points: 30000
+  aspect: 0.8
+  min_crop: 0.5
+  max_crop: 1.0
+
+crop_min_size: 20000
+crop_length: 6.0
+cropping_v1: true

diff --git a/conf/matcher/hungarian_matcher_mask3df.yaml b/conf/matcher/hungarian_matcher_mask3df.yaml
new file mode 100644
index 0000000..06cbe52
--- /dev/null
+++ b/conf/matcher/hungarian_matcher_mask3df.yaml
@@ -0,0 +1,15 @@
+# @package _group_
+# Mask3D-F paper appendix: L = 5 L_dice + 2 L_ce (mask CE).
+# In Mask3D these weights are taken from matcher costs
+# (see trainer/trainer.py weight_dict from matcher.cost_*).
+#
+# Copy to third_party/Mask3D/conf/matcher/ and select via hydra:
+#   matcher=hungarian_matcher_mask3df
+# full_train.sh overrides: v8 cost_mask=0.5 / cost_dice=5 / num_points=-1
+_target_: models.matcher.HungarianMatcher
+cost_class: 2.
+cost_mask: 2.   # paper λ=2; full_train overrides lower to fight empty-mask
+cost_dice: 5.   # Dice λ=5
+# -1 = all voxels (Mask3D default / paper-like). Use a fraction (e.g. 0.125) only if OOM.
+# v5+ full_train.sh overrides to -1 under crop.
+num_points: -1
